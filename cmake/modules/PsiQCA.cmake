# Link the same QCA core and static provider in the application and smoke tests.
function(psi_link_qca target)
    if(TARGET Qca3::Qca)
        set(_qca_target Qca3::Qca)
    else()
        set(_qca_target Qca::Qca)
    endif()
    target_link_libraries(${target} ${_qca_target})
    if(IRIS_BUNDLED_QCA)
        target_compile_definitions(${target} PRIVATE QCA_STATIC)
        return()
    endif()
    get_target_property(_qca_type ${_qca_target} TYPE)
    if(NOT _qca_type STREQUAL "STATIC_LIBRARY")
        return()
    endif()

    if(WIN32)
        set(_provider wincrypto)
    else()
        set(_provider ossl)
    endif()
    get_target_property(_includes ${_qca_target} INTERFACE_INCLUDE_DIRECTORIES)
    set(_roots)
    foreach(_include IN LISTS _includes)
        if(IS_ABSOLUTE "${_include}")
            get_filename_component(_root "${_include}/../../.." ABSOLUTE)
            list(APPEND _roots "${_root}")
        endif()
    endforeach()
    find_library(PSI_QCA_PLUGIN_LIBRARY_RELEASE NAMES qca-${_provider}
        HINTS ${_roots} PATH_SUFFIXES lib/qca3-qt${QT_DEFAULT_MAJOR_VERSION}/crypto
        lib/qca-qt${QT_DEFAULT_MAJOR_VERSION}/crypto)
    find_library(PSI_QCA_PLUGIN_LIBRARY_DEBUG NAMES qca-${_provider}d
        HINTS ${_roots} PATH_SUFFIXES lib/qca3-qt${QT_DEFAULT_MAJOR_VERSION}/crypto
        lib/qca-qt${QT_DEFAULT_MAJOR_VERSION}/crypto)
    include(SelectLibraryConfigurations)
    select_library_configurations(PSI_QCA_PLUGIN)
    if(NOT PSI_QCA_PLUGIN_FOUND)
        message(FATAL_ERROR "Static QCA requires the qca-${_provider} plugin library")
    endif()
    target_compile_definitions(${target} PRIVATE QCA_STATIC)
    target_link_libraries(${target} ${PSI_QCA_PLUGIN_LIBRARIES} ${_qca_target})
    if(WIN32)
        target_link_libraries(${target} bcrypt ncrypt secur32 crypt32 ws2_32)
    else()
        find_package(OpenSSL REQUIRED)
        target_link_libraries(${target} OpenSSL::Crypto OpenSSL::SSL)
    endif()
endfunction()
